# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 키가 담긴 .env 류는 모두 제외 (민감정보)
.env
.env.*
# 단, 플레이스홀더만 담긴 설정 템플릿은 커밋 허용
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TTS 생성용 로컬 venv (scripts/gen-audio.ts 의 EDGE_TTS 로 지정해 사용)
.venv-tts/

# 기출 원본(문제지·정답표 PDF)과 추출 텍스트 — 저작권상 커밋 금지.
# 문항 저작권: 국사편찬위원회 / 사진 저작권: 원저작자. 개인 학습 목적 외 이용은
# 한국복제전송저작권협회와 협의 필요 → 로컬 분석 산출물로만 둔다.
# 커밋하는 것은 scripts/gen-exam-frequency.ts 가 만드는 집계 데이터뿐이다.
/data/exams-raw/

# 기출 PDF 텍스트 추출용 로컬 venv (scripts/exam-pipeline/extract.ts 가 사용)
.venv-exam/

# 파이썬 추출 스크립트 캐시
__pycache__/
